# Core
FLASK_ENV=development
PORT=5000
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-a-different-long-random-string
FRONTEND_ORIGIN=http://localhost:5173

# Only needed if the backend is deployed on a different subdomain than the
# frontend (e.g. api.americanbusinessformations.com backend,
# americanbusinessformations.com frontend). Leading dot, no scheme:
# JWT_COOKIE_DOMAIN=.americanbusinessformations.com
# Leave blank/unset when frontend and backend share the exact same origin.
JWT_COOKIE_DOMAIN=

# Database (omit or leave blank for local SQLite fallback under server/data/dev.db)
DATABASE_URL=

# Email (transactional emails are skipped and logged when these are blank)
INFO_EMAIL=info@americanbusinessformations.com
SUPPORT_EMAIL=info@americanbusinessformations.com
FROM_EMAIL=info@americanbusinessformations.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Payments (Stripe) checkout returns a clear "not configured" response until these are set
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Texas filing configuration confirm against the Texas Secretary of State before trusting in production
TEXAS_FILING_FEE=300
TEXAS_FILING_FEE_VERIFIED=false

# File storage
UPLOAD_DIR=

# Rate limiting storage (use redis://... in production for multi-worker deployments)
RATELIMIT_STORAGE_URI=memory://

# Only read by `python seed.py` (one-time/idempotent catalog + optional admin
# seeding) not read by the running app itself. Leave SEED_ADMIN_PASSWORD
# unset to skip creating an admin account; seed.py refuses to create one
# with no password rather than defaulting to something guessable.
SEED_ADMIN_EMAIL=admin@americanbusinessformations.com
SEED_ADMIN_PASSWORD=
