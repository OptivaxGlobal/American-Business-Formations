VITE_API_URL=http://127.0.0.1:5000/api

# Display-only fallback for the Texas filing fee shown on marketing pages
# (src/config/texas.js) before the real config loads. Never determines what
# a customer is actually charged server/.env's TEXAS_FILING_FEE (read via
# GET /api/texas-config, server/app/services/texas.py) is the source of
# truth checkout.py always computes real order totals server-side. Keep
# this in sync with the backend value so the marketing page and checkout
# never show two different numbers.
VITE_TX_FILING_FEE=300
